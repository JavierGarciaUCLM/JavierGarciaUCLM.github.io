---
// Botón para alternar el idioma de un post de proyecto bilingüe.
// - lang: idioma de la página ACTUAL ("en" | "es")
// - translationUrl: ruta de la versión en el otro idioma
export interface Props {
  lang: string;
  translationUrl: string;
}

const { lang, translationUrl } = Astro.props;
---

<div class="relative">
  <div class="absolute top-1 right-1 z-10">
    <section class="inline-block px-3 py-2 bg-base-100 rounded-lg shadow-md border border-base-400 hover:shadow-lg transition-shadow">
      <a href={translationUrl} class="flex items-center gap-2 text-sm cursor-pointer">
        {lang === "en" ? (
          <>
            <img src="/language/SP.svg" alt="Bandera de España" class="w-5 h-5" />
            <span>Leer en español</span>
          </>
        ) : (
          <>
            <img src="/language/GB.svg" alt="UK flag" class="w-5 h-5" />
            <span>Read in English</span>
          </>
        )}
      </a>
    </section>
  </div>
</div>
