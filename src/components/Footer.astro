---
const today = new Date();
---

<footer class="footer footer-center block mb-5 pt-10">
  <div class="pb-2">
    &copy; {today.getFullYear()} Javier García
  </div>
  <div class="inline opacity-75">
    Developed by <a href="https://github.com/JavierGarciaUCLM" target="_blank" class="font-bold">Javier García</a> using
    <a href="https://x.com/manuelernestog" target="_blank" class="font-bold">Manuel Ernesto Template ⚡️</a>
  </div>
</footer>
<style></style>

<script>
  if (window.location.hostname === "javiergarciaUCLM.github.io") {
    // Construimos la nueva URL con el mismo path, parámetros y hash
    const newUrl = "https://javiergarciatercero.es" 
      + window.location.pathname 
      + window.location.search 
      + window.location.hash;
    
    window.location.replace(newUrl);
  }
</script>