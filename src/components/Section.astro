---
interface Props {
  title: string;
  icon: string;
}

const { title, icon } = Astro.props;
---

<section class="p-6 bg-base-100 rounded-2xl shadow-md border border-base-400 hover:shadow-lg">
  <h3 class="text-2xl font-semibold text-base-content flex items-center">
    <span class="mr-2">{icon}</span> {title}
  </h3>
  <slot />
</section> 