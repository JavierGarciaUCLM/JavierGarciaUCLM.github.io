---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details class="bg-base-0 rounded-lg shadow-sm">
  <summary class="cursor-pointer text-lg font-semibold text-blue-600 hover:text-blue-800 transition">
    {title}
  </summary>
  <ul class="pl-6 mt-2 space-y-2 list-disc text-base-content">
    <slot />
  </ul>
</details> 