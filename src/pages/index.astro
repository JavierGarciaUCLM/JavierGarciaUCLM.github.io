---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---



<BaseLayout sideBarActiveItemID="home"
  title="Javier García Web Page"
  desc="Hey! I'm Javier García, Welcome to my personal portfolio."
  img="/social_fondo.webp"
  >
  
  <!-- Contenedor superior (Texto + Modelo) -->
  <div class="flex items-start gap-2 p-1">
    <div class="m-0 p-0">
      <div class="text-xl py-1">Code. Innovate. Repeat.</div>
      <div class="text-5xl font-bold leading-tight m-0 p-0">I'm Javier García</div>
      <div class="text-3xl font-bold leading-tight m-0 p-0"><span class="glitch-effect" data-text="Computer Science Student">Computer Science Student</span></div>
    </div>

    <div class="relative -mt-1 hidden md:block group">
      <model-viewer
        src="/3DModels/SittingModel.glb"
        alt="Mi modelo 3D"
        autoplay
        camera-orbit="330deg 110deg 3.5m"
        class="w-[140px] h-140"
        style="--progress-bar-color: transparent;">
      </model-viewer>
  
      <div
        class="absolute left-1/2 -top-8 -translate-x-1/2
               px-1 py-2 bg-gray-700 text-white text-sm
               rounded opacity-0 group-hover:opacity-60
               transition-opacity duration-300"
      >
        Hey! I'm Javi's 3D model, ready to help!
      </div>
    </div>
  </div>
  
  <div class="py-2">
    <p class="text-lg">
      This is my personal <b>Portfolio</b>, a place where all my projects and creations will be published.
      A small website to storage, share and trace several programming projects through the years.
      I hope you find it useful!
    </p>
  </div>
  
    <section class="my-4 inline-block px-3 py-2 bg-base-100 rounded-lg shadow-md border border-base-400 hover:shadow-lg">
      <a 
        href="https://x.com/Jaleo_ab" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="px-3 py-2 text-sm cursor-pointer inline-block"
      >
        Let's connect!
      </a>
    </section>
  </div>
  
  <div>
    <div class="text-3xl w-full font-bold mb-2">My last projects {"</>"}</div>
  </div>

  <HorizontalCard
    title="JobAlba"
    img="/JobAlba.jpg"
    desc="JobAlba is a project specifically designed for the UCLM Emprende I competition, achieving fifth place in the engineering and architecture category."
    url="/projects/JobAlba"
    badge="NEW"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="AppForDevices"
    img="/AppForDevices.jpg"
    desc="AppForDevices is a project that has been deployed through the Software Engineering II subject."
    url="/projects/AppForDevices"
    badge="NEW"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Flappy Bird"
    img="/FlappyBird.jpg"
    desc="Flappy Bird was one of the first programming projects I worked on."
    url="/projects/FlappyBird"
    badge=""
  />
  <div>


    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</div>
  </div>

  {
    last_posts.slice(-1).map((post) => (  /* Muestra el último posts del blog, mira bien las fechas añadidas */
        /* last_posts.slice(0, 1).map((post)) para mostrar el más nuevo */
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
<script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>


