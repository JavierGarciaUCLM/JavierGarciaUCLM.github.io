---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="CV in English | Javier García" sideBarActiveItemID="cv">
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href={new URL('/cv', Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL('/cv-es', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/cv', Astro.site)} />
  </Fragment>

  <!-- Botón de idioma -->
  <div class="relative">
    <div class="absolute top-1 right-1 z-10 flex gap-3">
      <section class="inline-block px-3 py-2 bg-base-100 rounded-lg shadow-md border border-base-400 hover:shadow-lg transition-shadow">
        <a href="/cv-es" class="flex items-center gap-2 text-sm cursor-pointer">
          <img src="/language/SP.svg" alt="Bandera de España" class="w-5 h-5" />
          <span>Translate to Spanish</span>
        </a>
      </section>
    </div>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-4 text-justify">
    Computer Science and Engineering graduate (2026) and MSc student in Philosophy for Contemporary Challenges (UOC),
    researching the honesty and interpretability of large language models. My current question: when an LLM abandons a
    correct answer under user pressure, does it still represent the truth internally? Previous work includes an empirical
    cross-model study on sycophancy and a thesis on synthetic empathy in generative AI. Professional background in
    production-grade API architectures and integrations (MuleSoft/CloudHub 2.0, Salesforce).
  </div>

  <div class="mb-10">
    <span class="font-semibold">Seeking a PhD position in LLM interpretability and truthfulness.</span>
    <a href="mailto:garter.javier@gmail.com" class="underline ml-1">garter.javier@gmail.com</a>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Research</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Master's Thesis: Latent Knowledge and Sycophancy in LLMs"
      subtitle="In progress · Universitat Oberta de Catalunya (UOC)"
    >
      Investigates whether language models keep representing the correct answer internally when they yield to user
      pressure. Combines a philosophical analysis of lying and knowledge with probing of internal truth representations
      in open-weight models.
    </TimeLineElement>
    <TimeLineElement
      title="Empirical Study of Sycophancy in LLMs"
      subtitle="Ongoing · Claude Sonnet, GPT-4o, Llama 3.3 70B"
    >
      3×3 factorial design (three models, three levels of refutation pressure), 270 annotated interactions, full
      collection, annotation and statistical analysis pipeline (Cohen's kappa). Preliminary results: capitulation rates up
      to 26.7% in GPT-4o versus ~4.4% in the other models. IMRaD write-up targeting a scientific venue.
    </TimeLineElement>
    <TimeLineElement
      title="Bachelor's Thesis: Synthetic Empathy in Generative AI: Ethics and Regulation"
      subtitle="April 2025 – July 2026 · UCLM / UPV-EHU"
    >
      Technical analysis of the Transformer architecture (embeddings, self-attention, RLHF) as a mechanism producing
      responses perceived as empathic without underlying subjective experience. Taxonomy of harm patterns (parasocial
      attachment, algorithmic paternalism, erosion of decisional autonomy) and six design criteria for emotionally
      interactive AI.
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="MSc in Philosophy for Contemporary Challenges"
      subtitle="Since October 2026 at Universitat Oberta de Catalunya (UOC)"
      description="Technoscientific challenges track"
    />
    <TimeLineElement
      title="Bachelor's Degree in Computer Science and Engineering, IT track (bilingual programme)"
      subtitle="2022 – 2026 at University of Castilla-La Mancha (Albacete) and Euskal Herriko Unibertsitatea (San Sebastián, SICUE exchange)"
      description="IT infrastructure, cybersecurity, web systems and knowledge-based technologies"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="MuleSoft & Salesforce Developer"
      subtitle="Since June 2025 at Teknei, San Sebastián, Spain"
    >
      Design and implementation of a multi-connector integration architecture on CloudHub 2.0, connecting Salesforce with
      ERPs (Navision, OData V4), HR platforms, ITSM (JIRA Assets) and industrial telemetry APIs. Development of an OAuth2
      provider, API Gateways, standardised error handling and team-wide MuleSoft development standards.
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Awards & Projects</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Gipuzkoa AI Hackathon, Urban Challenge · Top 3 of 60 teams"
      subtitle="2026 · Team GIE Labs"
      description="AI data agent for the analysis of road accidents."
    />
    <TimeLineElement
      title="DIVINO / mapa.wine"
      subtitle="Since 2025 · Co-founder"
      description="Geolocated directory of ~3,943 Spanish wineries: scraping, fuzzy-matching and geocoding pipeline. Next.js, Turso, Cloudflare."
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications</div>
  </div>

  <ul class="list-disc mx-6 mb-10 grid gap-2">
    <li>
      MuleSoft Certified Developer – Level 1 (Mule 4) · In progress
    </li>
    <li>
      <a href="/docs/AWSCetificate.pdf" target="_blank">Amazon Connect Specialist (Click for certificate)</a>
      <br>
      <span class="text-sm italic">Certified by AWS Training & Certification</span>
    </li>
  </ul>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Volunteer Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="State-level student representative of UCLM in RITSI"
      subtitle="2022 – 2026 · National Association of Computer Science Students"
      description="Represented UCLM Computer Science students in national assemblies and contributed to national-level decisions on student matters."
    />
    <TimeLineElement
      title="First-year student mentor"
      subtitle="September 2024 – July 2025 at University of Castilla-La Mancha"
      description="Academic and campus orientation for first-year students."
    />
    <TimeLineElement
      title="Volunteer web developer"
      subtitle="Les Chamis de Mamie · Cat rescue association, Hendaye"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <div class="mb-10 grid gap-3">
    <div><span class="font-semibold">AI & Research:</span> Transformer architecture · RLHF · Experimental design · Statistical analysis · Corpus annotation</div>
    <div><span class="font-semibold">Development:</span> Python · Java · TypeScript · SQL · XML/XSD · Git</div>
    <div><span class="font-semibold">Integration:</span> MuleSoft Anypoint · CloudHub 2.0 · DataWeave 2.0 · OpenAPI 3.0 · OAuth2/JWT · OData V4</div>
    <div><span class="font-semibold">Salesforce:</span> Apex · Flows · Service Cloud</div>
    <div><span class="font-semibold">Languages:</span> Spanish (native) · English (C1 reading/listening, B2 writing/speaking)</div>
  </div>

  <!-- Contenedor: fijado abajo a la derecha, inicialmente fuera de la pantalla (translate-x-full) -->
  <div
    id="calamardo-container"
    class="fixed bottom-5 right-0 z-10 flex flex-col items-center gap-3 p-4 transform translate-x-full transition-transform duration-700 bg-transparent"
  >
    <p class="font-semibold text-base-content bg-base-100/70 px-2 py-1 rounded-md">
      Do you want more information?
    </p>

    <div class="flex space-x-2">
      <section class="inline-block px-3 py-2 bg-base-100 rounded-lg shadow-md border border-base-400 hover:shadow-lg">
        <button class="px-3 py-2 text-sm cursor-pointer inline-block" onclick="respuestaSi()">
          Show me!
        </button>
      </section>
      <section class="inline-block px-3 py-2 bg-base-100 rounded-lg shadow-md border border-base-400 hover:shadow-lg">
        <button class="px-3 py-2 text-sm cursor-pointer inline-block" onclick="respuestaNo()">
          No, thanks
        </button>
      </section>
    </div>

    <model-viewer
      src="/3DModels/BackedModel.glb"
      alt="Mi modelo 3D"
      camera-controls
      autoplay
      class="w-[160px] h-[160px]"
      style="--progress-bar-color: transparent;">
    </model-viewer>
  </div>

  <script type="module" src="https://unpkg.com/@google/model-viewer@4.4.0/dist/model-viewer.min.js" integrity="sha384-wjsPzEO+lXOf7d9csIDfAQpPt2OKuUU3m0K9qsdKIuzX4N8czSF6hdh23eAbZa3p" crossorigin="anonymous"></script>

  <script is:inline>
    function mostrarModal() {
      const container = document.getElementById('calamardo-container');
      if (container) {
        container.classList.remove('translate-x-full');
        container.classList.add('translate-x-0');
      }
    }

    function ocultarModal() {
      const container = document.getElementById('calamardo-container');
      if (container) {
        container.style.display = 'none';
      }
    }

    window.addEventListener('load', () => {
      setTimeout(mostrarModal, 5000);
    });

    document.addEventListener('astro:after-swap', () => {
      setTimeout(mostrarModal, 5000);
    });

    function respuestaSi() {
      window.open("https://www.linkedin.com/in/javier-garcia-tercero", "_blank");
    }

    function respuestaNo() {
      ocultarModal();
    }
  </script>
</BaseLayout>