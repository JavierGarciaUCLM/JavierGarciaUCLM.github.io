---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Collapsible from "../../components/Collapsible.astro";
import ResourceLink from "../../components/ResourceLink.astro";
---
<BaseLayout title="Cuarto curso: ESIIAB" sideBarActiveItemID="notes">
  <div class="w-full max-w-4xl px-6 py-8 mx-auto">
    <h1 class="text-4xl font-bold mb-2">Cuarto curso</h1>
    <p class="text-gray-500 text-md mb-4">Consulta los materiales disponibles para cuarto.</p>

    <div class="text-justify text-lg leading-relaxed space-y-6">
      <h2 class="text-2xl font-semibold mt-6">Material disponible</h2>
      <div class="space-y-8">
        <!-- Sistemas Web -->
        <Section title="Sistemas Web" icon="🌐">
          <ResourceLink 
            href="https://drive.google.com/file/d/1vl4fGeoqH2XR0hdU5nTOSt8KOns9YcqP/view?usp=drive_link" 
            text="Laboratorios" 
          />
          
          <Collapsible title="Entregables">
            <ResourceLink 
              href="/notes/Cuarto/SistemasWeb/Entregables/Deliverable1.zip" 
              text="Entregable 1" 
              download={true} 
            />
            <ResourceLink 
              href="/notes/Cuarto/SistemasWeb/Entregables/Deliverable3.zip" 
              text="Entregable 3" 
              download={true} 
            />
            <ResourceLink 
              href="/notes/Tercero/IPO/Snippets-Seminar3.txt" 
              text="Entregable 3 (Snippets)" 
              download={true} 
            />
            <ResourceLink 
              href="/notes/Cuarto/SistemasWeb/Entregables/Deliverable4.zip" 
              text="Entregable 4" 
              download={true} 
            />
          </Collapsible>
        </Section>
      </div>
    </div>

    <div class="mt-10">
      <h2 class="text-2xl font-semibold">¿Tienes más apuntes o documentos para compartir?</h2>
      <p class="text-gray-600 dark:text-gray-300 mb-4">Comparte tus archivos aquí.</p>
      <a
        href="mailto:jaleoab@gmail.com"
        class="inline-block px-6 py-3 text-white bg-blue-600 rounded-lg hover:bg-blue-800"
      >
        Enviar correo
      </a>
    </div>

    <div class="flex justify-end mt-10">
      <p class="text-gray-500 italic">
        Agradecimientos especiales a Lucian y Carmen Noblejas por compartir sus apuntes.
      </p>
    </div>
  </div>
</BaseLayout>
