---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Collapsible from "../../components/Collapsible.astro";
import ResourceLink from "../../components/ResourceLink.astro";
---
<BaseLayout title="Segundo curso: ESIIAB" sideBarActiveItemID="notes" lang="es">
  <div class="w-full max-w-4xl px-6 py-8 mx-auto">
    <h1 class="text-4xl font-bold mb-2">Segundo curso</h1>
    <p class="text-gray-500 text-md mb-4">Consulta los materiales disponibles para segundo.</p>

    <div class="text-justify text-lg leading-relaxed space-y-6">
      <h2 class="text-2xl font-semibold mt-6">Material disponible</h2>

      <div class="space-y-8">
        <Section title="Lógica" icon="🔍">
          <ResourceLink href="/notes/Segundo/Logica/LogicaCarmen.pdf" text="Asignatura completa" />
          <ResourceLink href="/notes/Segundo/Logica/tg1.pdf" text="Trabajo guiado" />
          <ResourceLink href="/notes/Segundo/Logica/ProLog.pptx" text="Presentación ProLog" />
          
          <Collapsible title="Exámenes">
            <ResourceLink href="/notes/Segundo/Logica/Control1.pdf" text="Control 1" />
            <ResourceLink href="/notes/Segundo/Logica/Control1PLD.pdf" text="Control 1 PLD" />
            <ResourceLink href="/notes/Segundo/Logica/EjercicioControl2.pdf" text="Ejercicio control 2" />
            <ResourceLink href="/notes/Segundo/Logica/SimulacroRC.pdf" text="Simulacro RC" />
            <ResourceLink href="/notes/Segundo/Logica/RC.pdf" text="RC" />
          </Collapsible>
        </Section>

        <Section title="Estructura de Datos" icon="🗂️">
          <ResourceLink href="/notes/Segundo/ED/GeneralED.pdf" text="Apuntes + Ejercicios + Exámenes" />
          <ResourceLink href="/notes/Segundo/ED/CarmenED.pdf" text="Asignatura completa" />
          <ResourceLink href="/notes/Segundo/ED/JavaProjects.7z" text="Ejercicios Java" download={true} />
          <ResourceLink href="/notes/Segundo/ED/PracticasHaskell.7z" text="Ejercicios Haskell" download={true} />
          <ResourceLink href="/notes/Segundo/ED/PolishNotationED.pdf" text="Apuntes Polish Notation" />
        </Section>

        <Section title="Ingeniería del Software I" icon="🛠️">
          <ResourceLink href="/notes/Segundo/SWI/GeneralSoftwareI.pdf" text="Apuntes + Ejercicios" />
          
          <Collapsible title="Prácticas">
            <ResourceLink href="/notes/Segundo/SWI/Proyecto/SRS1.pdf" text="Primera entrega" />
            <ResourceLink href="/notes/Segundo/SWI/Proyecto/ExamenSRS1.pdf" text="Examen primera entrega" />
            <ResourceLink href="/notes/Segundo/SWI/Proyecto/SRS2.pdf" text="Segunda entrega" />
            <ResourceLink href="/notes/Segundo/SWI/Proyecto/ExamenSRS2.pdf" text="Examen segunda entrega" />
            <ResourceLink href="/notes/Segundo/SWI/Proyecto/SRSOrdinario.pdf" text="Examen ordinario" />
          </Collapsible>
        </Section>

        <div class="relative">
          <Section title="Organización de Computadores (En proceso...)" icon="🖥️">
            <ResourceLink href="/notes/Primero/Fisica/GeneralOC.pdf" text="Apuntes + Ejercicios + Exámenes" />
            
            <Collapsible title="Prácticas">
              <ResourceLink href="/notes/Segundo/OC/Practicas/practica1oc.docx" text="Práctica 1" />
              <ResourceLink href="/notes/Segundo/OC/Practicas/practica2oc.docx" text="Práctica 2" />
              <ResourceLink href="/notes/Segundo/OC/Practicas/practica3oc.docx" text="Práctica 3" />
              <ResourceLink href="/notes/Segundo/OC/Practicas/practica4oc.docx" text="Práctica 4" />
              <ResourceLink href="/notes/Segundo/OC/Practicas/practica5oc.docx" text="Práctica 5" />
              <ResourceLink href="/notes/Segundo/OC/Practicas/practica6oc.docx" text="Práctica 6" />
            </Collapsible>
          </Section>
          
          <div class="hidden md:block absolute top-0 right-[-180px] z-50 group">
            <model-viewer
            src="/3DModels/FightingModel.glb"
            alt="Mi modelo 3D"
            autoplay
            camera-orbit="30deg 100deg 5m"
            class="w-[140px] h-140"
            style="--progress-bar-color: transparent;"
            ></model-viewer>
            <div
              class="absolute left-1/2 -top-8 -translate-x-1/2
               px-1 py-2 bg-gray-700 text-white text-sm
               rounded opacity-0 group-hover:opacity-60
               transition-opacity duration-300 whitespace-nowrap"
            >
                Peleón peleón
            </div>
          </div>
        </div>

        <Section title="Sistemas Operativos I" icon="⚙️">
          <ResourceLink href="/notes/Segundo/Operativos/GeneralOperativos.pdf" text="Apuntes + Ejercicios + Exámenes" />
          <ResourceLink href="/notes/Segundo/Operativos/ResumenPrimerParcial.pdf" text="Apuntes primer parcial" />
          <ResourceLink href="/notes/Segundo/Operativos/Carpeta2Parcial.7z" text="Carpeta segundo parcial" download={true} />
          <ResourceLink href="/notes/Segundo/Operativos/Practicas.7z" text="Carpeta prácticas" download={true} />
          <ResourceLink href="/notes/Segundo/Operativos/TrabajoLinux.7z" text="Carpeta trabajo (Linux)" download={true} />
          
          <Collapsible title="Ejercicios">
            <ResourceLink href="/notes/Segundo/Operativos/EjerciciosTema3.pdf" text="Ejercicios tema 3" />
            <ResourceLink href="/notes/Segundo/Operativos/EjerciciosTema4.pdf" text="Ejercicios tema 4.1" />
            <ResourceLink href="/notes/Segundo/Operativos/EjerciciosTema4.1.pdf" text="Ejercicios tema 4.2" />
          </Collapsible>
        </Section>

        <Section title="Estadística (En R)" icon="📊">
          <Collapsible title="Labs">
            <ResourceLink href="/notes/Segundo/Estadistica/Labs/Estadistica1.pdf" text="Laboratorio 1" />
            <ResourceLink href="/notes/Segundo/Estadistica/Labs/Estadistica2.pdf" text="Laboratorio 2" />
            <ResourceLink href="/notes/Segundo/Estadistica/Labs/Estadistica3.pdf" text="Laboratorio 3" />
            <ResourceLink href="/notes/Segundo/Estadistica/Labs/Estadistica4.pdf" text="Laboratorio 4" />
            <ResourceLink href="/notes/Segundo/Estadistica/Labs/Estadistica7.pdf" text="Laboratorio 7" />
            <ResourceLink href="/notes/Segundo/Estadistica/Labs/Estadistica8.pdf" text="Laboratorio 8" />
            <ResourceLink href="/notes/Segundo/Estadistica/Labs/Estadistica9.pdf" text="Laboratorio 9" />
            <ResourceLink href="/notes/Segundo/Estadistica/Labs/Estadistica10.pdf" text="Laboratorio 10" />
          </Collapsible>
          
          <Collapsible title="Exámenes">
            <ResourceLink href="/notes/Segundo/Estadistica/Examenes/ExamenRandom1.pdf" text="Examen 1" />
            <ResourceLink href="/notes/Segundo/Estadistica/Examenes/ExamenRandom2.pdf" text="Examen 2" />
            <ResourceLink href="/notes/Segundo/Estadistica/Examenes/UnoDeLosExamenes2324.pdf" text="Examen 23/24" />
          </Collapsible>
          
          <Collapsible title="Fórmulas">
            <ResourceLink href="/notes/Segundo/Estadistica/Formulas/AlgunaFuncionExamenEnR.pdf" text="Fórmulas random" />
            <ResourceLink href="/notes/Segundo/Estadistica/Formulas/FormularioFumadon.pdf" text="Fórmulas de todo" />
            <ResourceLink href="/notes/Segundo/Estadistica/Formulas/TestsR.7z" text="Más fórmulas" download={true} />
          </Collapsible>
        </Section>

        <Section title="Bases de Datos" icon="🗄️">
          <ResourceLink href="/notes/Segundo/BBDD/CarmenBBDD.pdf" text="Asignatura completa" />
          <ResourceLink href="/notes/Segundo/BBDD/Trabajo.7z" text="Trabajo" download={true} />
          
          <Collapsible title="Prácticas">
            <ResourceLink href="/notes/Segundo/BBDD/Practicas/practica1.sql" text="Práctica 1" download={true} />
            <ResourceLink href="/notes/Segundo/BBDD/Practicas/practica2.sql" text="Práctica 2" download={true} />
            <ResourceLink href="/notes/Segundo/BBDD/Practicas/practica3.sql" text="Práctica 3" download={true} />
            <ResourceLink href="/notes/Segundo/BBDD/Practicas/practica4.sql" text="Práctica 4" download={true} />
            <ResourceLink href="/notes/Segundo/BBDD/Practicas/practica5.sql" text="Práctica 5" download={true} />
            <ResourceLink href="/notes/Segundo/BBDD/Practicas/practica6.sql" text="Práctica 6" download={true} />
            <ResourceLink href="/notes/Segundo/BBDD/Practicas/practica7.sql" text="Práctica 7" download={true} />
            <ResourceLink href="/notes/Segundo/BBDD/Practicas/practica8.sql" text="Práctica 8" download={true} />
            <ResourceLink href="/notes/Segundo/BBDD/Practicas/practica9.sql" text="Práctica 9" download={true} />
            <ResourceLink href="/notes/Segundo/BBDD/Practicas/practica10.sql" text="Práctica 10" download={true} />
          </Collapsible>
        </Section>

        <Section title="Metodología" icon="💡">
          <ResourceLink href="/notes/Segundo/Metodologia/GeneralMetodologia.pdf" text="Apuntes + Ejercicios + Exámenes" />
          <ResourceLink href="/notes/Segundo/Metodologia/CarmenMetodologia.pdf" text="Asignatura completa" />
          
          <Collapsible title="Trabajos">
            <ResourceLink href="/notes/Segundo/Metodologia/Trabajos/TrabajoGreedy.pdf" text="Greedy" />
            <ResourceLink href="/notes/Segundo/Metodologia/Trabajos/TrabajoDynamic.pdf" text="Dynamic" />
            <ResourceLink href="/notes/Segundo/Metodologia/Trabajos/TrabajoBacktracking.pdf" text="Backtracking" />
          </Collapsible>
        </Section>

        <Section title="Programación Concurrente y Tiempo Real" icon="⏱️">
          <ResourceLink href="/notes/Segundo/Concurrentes/CarmenConcurrentes.pdf" text="Asignatura completa" />
          <ResourceLink href="/notes/Segundo/Concurrentes/Practicas.7z" text="Prácticas" download={true} />
        </Section>
        
        <Section title="Redes de Computadores II" icon="🌐">
          <ResourceLink href="https://javiergarciauclm.github.io/LogicalNetworkDesign/" text="Web para hacer diseños lógicos" />
          <ResourceLink href="/notes/Segundo/RedesII/GeneralRedes.pdf" text="Apuntes + Ejercicios + Exámenes" />
          <ResourceLink href="/notes/Segundo/RedesII/Bloque1.7z" text="Bloque 1" download={true} />
          <ResourceLink href="/notes/Segundo/RedesII/Bloque2.7z" text="Bloque 2" download={true} />
          <ResourceLink href="/notes/Segundo/RedesII/LucianPracticoFinal.zip" text="Examen práctico final" download={true} />
        </Section>
      </div>
    </div>

    <div class="mt-10">
      <h2 class="text-2xl font-semibold">¿Tienes más apuntes o documentos para compartir?</h2>
      <p class="text-gray-600 dark:text-gray-300 mb-4">Comparte tus archivos aquí.</p>
      <a
        href="mailto:jaleoab@gmail.com"
        class="inline-block px-6 py-3 text-white bg-blue-600 rounded-lg hover:bg-blue-800"
      >
        Enviar correo
      </a>
    </div>
    
    <div class="flex justify-end mt-10">
      <p class="text-gray-500 italic">
        Agradecimientos especiales a Lucian y Carmen Noblejas por compartir sus apuntes.
      </p>
    </div>
  </div>
</BaseLayout>

<script type="module" src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
