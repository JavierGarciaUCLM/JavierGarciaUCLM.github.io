---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Collapsible from "../../components/Collapsible.astro";
import ResourceLink from "../../components/ResourceLink.astro";
---
<BaseLayout title="Primer curso: ESIIAB" sideBarActiveItemID="notes">
  <div class="w-full max-w-4xl px-6 py-8 mx-auto">
    <h1 class="text-4xl font-bold mb-2">Primer curso</h1>
    <p class="text-gray-500 text-md mb-4">Consulta los materiales disponibles para primero.</p>

    <div class="text-justify text-lg leading-relaxed space-y-6">
      <h2 class="text-2xl font-semibold mt-6">Material disponible</h2>

      <div class="space-y-8">
        <Section title="Cálculo y Métodos Numéricos" icon="📘">
          <ResourceLink href="/notes/Primero/Calculo/GeneralCalculo.pdf" text="Apuntes + Ejercicios + Exámenes" />
          
          <Collapsible title="Presentaciones Matlab">
            <ResourceLink href="/notes/Primero/Calculo/Presentacion1.pdf" text="Presentación 1" />
            <ResourceLink href="/notes/Primero/Calculo/Presentacion2.pdf" text="Presentación 2" />
            <ResourceLink href="/notes/Primero/Calculo/Presentacion3.pdf" text="Presentación 3" />
            <ResourceLink href="/notes/Primero/Calculo/Presentacion4.pdf" text="Presentación 4" />
          </Collapsible>
        </Section>

        <Section title="Fundamentos de Gestión Empresarial" icon="💼">
          <ResourceLink href="/notes/Primero/Empresas/GeneralEmpresas.pdf" text="Apuntes + Ejercicios + Exámenes" />
        </Section>

        <Section title="Fundamentos de Programación I/II" icon="💻">
          <ResourceLink href="/notes/Primero/Programacion/GeneralProgramacion.pdf" text="Apuntes genéricos" />
          <ResourceLink href="/notes/Primero/Programacion/FPII/ExplicacionTests.pdf" text="Explicación tests FPII" />
          
          <Collapsible title="Trabajo en grupo FPII (Farmacia)">
            <ResourceLink href="/notes/Primero/Programacion/FPII/Proyecto/Enunciado.pdf" text="Enunciado" />
            <ResourceLink href="/notes/Primero/Programacion/FPII/Proyecto/PaqG13_Project-Final.7z" text="Trabajo acabado" download={true} />
          </Collapsible>
          
          <Collapsible title="Prácticas FPII">
            <ResourceLink href="/notes/Primero/Programacion/FPII/Practicas/Lab1Project.7z" text="Práctica 1" download={true} />
            <ResourceLink href="/notes/Primero/Programacion/FPII/Practicas/Lab02bueno.rar" text="Práctica 2" download={true} />
            <ResourceLink href="/notes/Primero/Programacion/FPII/Practicas/Lab3Extended.zip" text="Práctica 3" download={true} />
            <ResourceLink href="/notes/Primero/Programacion/FPII/Practicas/calculadoraLab4Grupo19.7z" text="Práctica 4" download={true} />
          </Collapsible>
        </Section>

        <Section title="Fundamentos Físicos de la Informática" icon="⚛️">
          <ResourceLink href="/notes/Primero/Fisica/GeneralFisica.pdf" text="Apuntes + Ejercicios + Exámenes" />
          <ResourceLink href="/notes/Primero/Fisica/Examenes.pdf" text="Exámenes resueltos" />
        </Section>

        <Section title="Tecnología de Computadores" icon="🖥️">
          <ResourceLink href="/notes/Primero/TC/GeneralTC.pdf" text="Apuntes + Ejercicios + Exámenes" />
        </Section>

        <Section title="Álgebra y Matemática Discreta" icon="➗">
          <ResourceLink href="/notes/Primero/Algebra/GeneralAlgebra.pdf" text="Trabajo + Apuntes + Ejercicios + Exámenes" />
        </Section>

        <Section title="Estructura de Computadores" icon="🖧">
          <ResourceLink href="/notes/Primero/EC/GeneralEC.pdf" text="Apuntes pobres" />
          <ResourceLink href="/notes/Primero/EC/LucesLed.txt" text="Segundo examen luces LED" />
          
          <Collapsible title="Prácticas">
            <ResourceLink href="/notes/Primero/EC/Practica4.pdf" text="Práctica 4" />
            <ResourceLink href="/notes/Primero/EC/Practica5.pdf" text="Práctica 5" />
            <ResourceLink href="/notes/Primero/EC/Practica6.pdf" text="Práctica 6" />
            <ResourceLink href="/notes/Primero/EC/Practica8.pdf" text="Práctica 8" />
            <ResourceLink href="/notes/Primero/EC/Practica9.pdf" text="Práctica 9" />
            <ResourceLink href="/notes/Primero/EC/Practica10.pdf" text="Práctica 10" />
          </Collapsible>
        </Section>

        <Section title="Redes de Computadores I" icon="🌐">
          <ResourceLink href="#" text="En proceso..." />
        </Section>

        <Section title="Sistemas de Información" icon="📊">
          <ResourceLink href="/notes/Primero/Sistemas/GeneralSistemas.pdf" text="Apuntes + Ejercicios + Exámenes" />
        </Section>
      </div>
    </div>

    <div class="mt-10">
      <h2 class="text-2xl font-semibold">¿Tienes más apuntes o documentos para compartir?</h2>
      <p class="text-gray-600 dark:text-gray-300 mb-4">Comparte tus archivos aquí.</p>
      <a
        href="mailto:jaleoab@gmail.com"
        class="inline-block px-6 py-3 text-white bg-blue-600 rounded-lg hover:bg-blue-800"
      >
        Enviar correo
      </a>
    </div>
    
    <div class="flex justify-end mt-10">
      <p class="text-gray-500 italic">
        Agradecimientos especiales a Lucian y Carmen Noblejas por compartir sus apuntes.
      </p>
    </div>
  </div>
</BaseLayout>
