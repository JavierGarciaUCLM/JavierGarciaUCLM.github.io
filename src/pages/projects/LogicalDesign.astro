---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Calculadora de diseño lógico de red" sideBarActiveItemID="projects">
  <div class="w-full max-w-4xl px-6 py-8 mx-auto">
    <div class="hero-section mb-8">
      <h1 class="text-4xl font-bold mb-2">Logical Network Design Calculator</h1>
      <p class="text-gray-500 text-lg">Tool to calculate and design subnets easily and intuitively.</p>
    </div>

    <div class="text-lg leading-relaxed space-y-4 mb-8">
      <p>
        This tool is a simple and intuitive way to calculate and design subnets, with the objectivo of
        helping undergraduate Computer Science students with networking-related subjects.
      </p>
      <p>
        <strong>Main features:</strong>
      </p>
      <ul class="list-disc pl-6 space-y-2">
        <li>Automatic subnet calculation</li>
        <li>Multi-device support</li>
        <li>ES/EN interface</li>
        <li>Easy to use and understand</li>
      </ul>
    </div>

    <section class="tool-section">
      <h2 class="text-2xl font-bold mb-4">Try the tool</h2>
      <div class="tool-container">
        <iframe
          src="https://javiergarciauclm.github.io/LogicalNetworkDesign/"
          loading="lazy"
          allowfullscreen
          title="Calculadora de diseño lógico de red">
        </iframe>
      </div>
      <a href="https://javiergarciauclm.github.io/LogicalNetworkDesign/" target="_blank" rel="noopener noreferrer" class="text-black-600 underline hover:text-black-800">
        <strong>Link to the website</strong>
      </a>
    </section>

    <div class="w-full max-w-4xl mx-auto mt-10">
        <h2 class="text-2xl font-bold mb-4">Project Repository</h2>
        <div id="github-repo" class="p-6 border rounded-lg shadow-md bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-gray-200">
          <p>Loading repository data...</p>
        </div>
  
        <script>
          async function fetchGitHubRepo() {
            const response = await fetch('https://api.github.com/repos/JavierGarciaUCLM/LogicalNetworkDesign');
            const repoData = await response.json();
  
            document.getElementById('github-repo').innerHTML = `
              <h3 class="text-xl font-semibold">${repoData.full_name}</h3>
              <p>${repoData.description || 'No description available.'}</p>
              <p><strong>Last updated:</strong> ${new Date(repoData.updated_at).toLocaleDateString()}</p>
              <p><strong>Stars:</strong> ${repoData.stargazers_count} ⭐</p>
              <a href="${repoData.html_url}" target="_blank" class="text-blue-600 underline hover:text-blue-800 dark:text-blue-400">View on GitHub</a>
            `;
          }
          fetchGitHubRepo();
        </script>
      </div>
  </div>
</BaseLayout>

<style>
  .tool-section {
    display: flex;
    flex-direction: column;
    gap: .75rem;
    margin: 2rem 0;
  }

  .tool-container {
    position: relative;
    width: 100%;
    
    padding-bottom: 60%; 
    overflow: hidden;
    border-radius: 1rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    border: 1px solid #e5e7eb;
  }

  .tool-container iframe {
    position: absolute;
    top: 0;
    left: 0; 
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (prefers-color-scheme: dark) {
    .tool-container {
      border-color: #374151;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    }
  }
</style>
